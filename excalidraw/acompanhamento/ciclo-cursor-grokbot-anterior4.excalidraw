1, "type": "text", "id": "a9_t", "x": 189, "y": 290, "width": 240.0, "height": 40.0, "endArrowhead": "arrow", "startArrowhead": null, "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "text": "ERROR / slug sem casar:\navisa Elienaldo, sem loop", "originalText": "ERROR / slug sem casar:\navisa Elienaldo, sem loop", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": null, "lineHeight": 1.25}, {"angle": 0, "strokeColor": "#fbbf24", "backgroundColor": "#422006", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 25, "version": 1, "versionNonce": 31, "isDeleted": false, "boundElements": [{"type": "text", "id": "leg_t"}], "locked": false, "link": null, "updated": 1, "type": "rectangle", "id": "leg", "x": 40, "y": 1060, "width": 1180, "height": 120, "roundness": {"type": 3}}, {"angle": 0, "strokeColor": "#fbbf24", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 25, "version": 1, "versionNonce": 31, "isDeleted": false, "boundElements": [], "locked": false, "link": null, "updated": 1, "type": "text", "id": "leg_t", "x": 122.4, "y": 1075.0, "width": 1015.2, "height": 90.0, "roundness": {"type": 3}, "text": "Legenda: tracejado = pendente/erro. Diagrama generico, vale para todas as fases.\nO Cursor so recebe o POST, executa o que foi pedido e retorna FINISHED ou ERROR.\nNa API v1 o webhook ainda e 'em breve'; o retorno automatico depende do webhook v0 (so\nFINISHED e ERROR) ou do hook de parada do Cursor - decisao em aberto. Nenhuma chave real aqui.", "originalText": "Legenda: tracejado = pendente/erro. Diagrama generico, vale para todas as fases.\nO Cursor so recebe o POST, executa o que foi pedido e retorna FINISHED ou ERROR.\nNa API v1 o webhook ainda e 'em breve'; o retorno automatico depende do webhook v0 (so\nFINISHED e ERROR) ou do hook de parada do Cursor - decisao em aberto. Nenhuma chave real aqui.", "fontSize": 18, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "leg", "lineHeight": 1.25}, {"angle": 0, "strokeColor": "#fbbf24", "backgroundColor": "#422006", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 901, "version": 1, "versionNonce": 17, "isDeleted": false, "boundElements": [{"type": "text", "id": "dec_t"}], "locked": false, "link": null, "updated": 1, "type": "diamond", "id": "dec", "x": 1350, "y": 620, "width": 300, "height": 170, "roundness": {"type": 3}}, {"angle": 0, "strokeColor": "#fbbf24", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 902, "version": 1, "versionNonce": 17, "isDeleted": false, "boundElements": [], "locked": false, "link": null, "updated": 1, "type": "text", "id": "dec_t", "x": 1424.4, "y": 682.5, "width": 151.2, "height": 45.0, "roundness": {"type": 3}, "text": "Slug casa com\no livro-razao?", "originalText": "Slug casa com\no livro-razao?", "fontSize": 18, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "dec", "lineHeight": 1.25}, {"angle": 0, "strokeColor": "#a78bfa", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 904, "version": 1, "versionNonce": 17, "isDeleted": false, "boundElements": [], "locked": false, "link": null, "updated": 1, "type": "text", "id": "grokc_t", "x": 1290, "y": 282, "width": 410.4, "height": 22.5, "roundness": {"type": 3}, "text": "Grok Bot (app): hospeda bots e rotinas", "originalText": "Grok Bot (app): hospeda bots e rotinas", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25}, {"angle": 0, "fillStyle": "solid", "stroke